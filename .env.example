# Copia questo file in .env.local e inserisci i valori del tuo progetto.
# Nessun segreto va mai committato: qui stanno solo valori pubblici lato client.

# Supabase (piano Free, regione eu-central-1 Francoforte)
VITE_SUPABASE_URL=https://<id-progetto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chiave-anon-pubblica>

# Google Cloud (schermata di consenso con scope openid email profile + drive.file)
VITE_GOOGLE_CLIENT_ID=<id-client-oauth>.apps.googleusercontent.com
# Chiave API limitata al solo Google Picker e al dominio dell'app
VITE_GOOGLE_PICKER_API_KEY=<chiave-picker>
# Numero del progetto Google Cloud (appId del Picker)
VITE_GOOGLE_APP_ID=<numero-progetto>
