# Facoltativo: copia in .env.local per provare l'accesso Google con un tuo progetto.
# L'ID client OAuth è pubblico (non è un segreto); quello dell'app pubblicata sta in src/config.ts.
VITE_GOOGLE_CLIENT_ID=<id-client-oauth>.apps.googleusercontent.com
# Chiave API pubblica del selettore file di Google (Picker), limitata al sito: quella dell'app sta in src/config.ts.
VITE_GOOGLE_API_KEY=<chiave-api-picker>
# Progetto Firebase (piano gratuito) per la copia condivisa e cifrata dei nuclei: valori pubblici.
VITE_FIREBASE_API_KEY=<chiave-api-web-firebase>
VITE_FIREBASE_PROJECT_ID=<id-progetto-firebase>
